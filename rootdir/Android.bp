prebuilt_etc {
    name: "fstab.qcom",
    src: "etc/fstab.qcom",
    vendor: true,
	required: ["fstab.qcom_ramdisk"],
}

prebuilt_etc {
    name: "fstab.qcom_ramdisk",
    src: "etc/fstab.qcom",
    filename: "fstab.qcom",
    ramdisk: true,
}

prebuilt_etc {
    name: "init.device.rc",
    src: "etc/init.device.rc",
    sub_dir: "init/hw",
    vendor: true,
}
